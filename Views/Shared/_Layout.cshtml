<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Local Artisan Marketplace</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#8b5e3c",
                        "background-light": "#f7f7f6",
                        "background-dark": "#1d1815",
                    },
                    fontFamily: {
                        "display": ["Work Sans", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Work Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 transition-colors duration-300">
    @if (TempData["Message"] != null)
    {
        <div class="fixed top-4 right-4 z-[100] bg-green-100 border border-green-300 text-green-800 px-6 py-3 rounded-lg shadow-lg flex items-center gap-2" id="toast-message">
            <span class="material-symbols-outlined text-green-600">check_circle</span>
            <span class="text-sm font-medium">@TempData["Message"]</span>
            <button onclick="this.parentElement.remove()" class="ml-2 text-green-600 hover:text-green-800">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
        <script>setTimeout(() => { var el = document.getElementById('toast-message'); if(el) el.remove(); }, 4000);</script>
    }
    @if (TempData["Error"] != null)
    {
        <div class="fixed top-4 right-4 z-[100] bg-red-100 border border-red-300 text-red-800 px-6 py-3 rounded-lg shadow-lg flex items-center gap-2" id="toast-error">
            <span class="material-symbols-outlined text-red-600">error</span>
            <span class="text-sm font-medium">@TempData["Error"]</span>
            <button onclick="this.parentElement.remove()" class="ml-2 text-red-600 hover:text-red-800">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
        <script>setTimeout(() => { var el = document.getElementById('toast-error'); if(el) el.remove(); }, 4000);</script>
    }
    @RenderBody()
</body>
</html>
