@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="relative flex min-h-screen flex-col overflow-x-hidden">
<div class="layout-container flex h-full grow flex-col">

<!-- Navigation -->
<header class="flex items-center border-b border-primary/10 px-4 md:px-10 py-4 bg-background-light dark:bg-background-dark sticky top-0 z-50">
    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 no-underline">
        <div class="text-primary">
            <span class="material-symbols-outlined text-3xl">brush</span>
        </div>
        <h2 class="text-slate-900 dark:text-slate-100 text-lg font-bold tracking-tight">Local Artisan Marketplace</h2>
    </a>
</header>

<main class="flex-1 flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-[960px] grid grid-cols-1 lg:grid-cols-2 gap-0 overflow-hidden rounded-xl shadow-2xl border border-primary/10">

        <!-- Hero/Image Section -->
        <div class="hidden lg:flex relative flex-col justify-end p-10 bg-primary/10">
            <div class="absolute inset-0 z-0">
                <img alt="Pottery workshop tools and clay" class="w-full h-full object-cover opacity-80 mix-blend-multiply" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9rBmKqrUVK1urAMVfSFqN5uGrqseaBYw8QxV2LCP70lhjKtFbP5iFoFrrzlwLhS0KVWajYOhOBEyBIZW0tx1fYz7t4Ild4Rl6venhCbpCG_UlVNUHr9y3CE-NvLQB73Ua1deH-mZXk6bs3TZGBE2isImKRxirT4GklUR8RQka66sA59ZmVijeVokCKynM01B6LBF38un3uWTdcOfX8ExPUc_FJogGn9OJT_l2FfVeDM42SD52Y0GlB64-Lyp47VoSthgmwmLmRkc" />
            </div>
            <div class="relative z-10 space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary text-white text-xs font-semibold uppercase tracking-wider">
                    <span class="material-symbols-outlined text-sm">verified</span>
                    Certified Handmade
                </div>
                <h1 class="text-4xl font-bold text-white leading-tight">Celebrate the Art of the Handmade</h1>
                <p class="text-white/90 text-lg">Join a community of 50,000+ artisans and collectors dedicated to preserving craft traditions.</p>
            </div>
        </div>

        <!-- Form Section -->
        <div class="bg-white dark:bg-background-dark p-8 md:p-12">
            <div class="mb-8">
                <h3 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Create Account</h3>
                <p class="text-slate-500 dark:text-slate-400 mt-2">Start your journey into the world of unique crafts.</p>
            </div>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
                    <ul class="text-sm text-red-600 dark:text-red-400 space-y-1 list-disc list-inside">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Role Toggle -->
                <div class="flex p-1 bg-primary/5 dark:bg-primary/10 rounded-xl">
                    <label class="flex-1 cursor-pointer group">
                        <input checked class="hidden peer" name="role" type="radio" value="Collector" id="role-collector" />
                        <div class="flex items-center justify-center py-3 rounded-lg text-sm font-semibold transition-all peer-checked:bg-white dark:peer-checked:bg-primary peer-checked:shadow-sm peer-checked:text-primary dark:peer-checked:text-white text-slate-500 dark:text-slate-400">
                            <span class="material-symbols-outlined mr-2 text-xl">person</span>
                            Collector
                        </div>
                    </label>
                    <label class="flex-1 cursor-pointer group">
                        <input class="hidden peer" name="role" type="radio" value="Artisan" id="role-artisan" />
                        <div class="flex items-center justify-center py-3 rounded-lg text-sm font-semibold transition-all peer-checked:bg-white dark:peer-checked:bg-primary peer-checked:shadow-sm peer-checked:text-primary dark:peer-checked:text-white text-slate-500 dark:text-slate-400">
                            <span class="material-symbols-outlined mr-2 text-xl">palette</span>
                            Artisan
                        </div>
                    </label>
                </div>

                <div class="space-y-4">
                    <!-- Name -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Full Name</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">person</span>
                            <input name="fullName" class="w-full pl-10 pr-4 py-3 rounded-lg border border-slate-200 dark:border-primary/20 bg-transparent focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all dark:text-white" placeholder="Full Name" type="text" required />
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Email Address</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">mail</span>
                            <input name="email" class="w-full pl-10 pr-4 py-3 rounded-lg border border-slate-200 dark:border-primary/20 bg-transparent focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all dark:text-white" placeholder="Email Address" type="email" required />
                        </div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Password</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400">lock</span>
                            <input name="password" class="w-full pl-10 pr-4 py-3 rounded-lg border border-slate-200 dark:border-primary/20 bg-transparent focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all dark:text-white" placeholder="••••••••" type="password" required />
                        </div>
                    </div>

                    <!-- Artisan Fields (hidden by default) -->
                    <div id="artisan-fields" class="space-y-4 pt-2 border-t border-primary/10 mt-4" style="display: none;">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Studio Name</label>
                                <input name="studioName" class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-primary/20 bg-transparent focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all dark:text-white" placeholder="Willow &amp; Clay" type="text" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Craft Type</label>
                                <select name="craftType" class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-primary/20 bg-transparent focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all dark:text-white appearance-none">
                                    <option value="Ceramics">Ceramics</option>
                                    <option value="Woodworking">Woodworking</option>
                                    <option value="Jewelry">Jewelry</option>
                                    <option value="Textiles">Textiles</option>
                                    <option value="Painting">Painting</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-start gap-3 py-2">
                    <input class="mt-1 rounded text-primary focus:ring-primary" id="terms" type="checkbox" />
                    <label class="text-sm text-slate-500 dark:text-slate-400 leading-tight" for="terms">
                        I agree to the <a class="text-primary hover:underline" href="#">Terms of Service</a> and <a class="text-primary hover:underline" href="#">Privacy Policy</a>.
                    </label>
                </div>

                <button class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2" type="submit">
                    <span class="material-symbols-outlined">how_to_reg</span>
                    Create My Account
                </button>
                <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-4">
                    Already have account?
                    <a asp-controller="Account" asp-action="Login" class="text-primary font-bold hover:underline">Log In</a>
                </p>
            </form>
        </div>
    </div>
</main>

<!-- Footer -->
<footer class="py-6 text-center text-slate-500 dark:text-slate-400 text-sm">
    <p>&copy; 2024 Local Artisan Marketplace. All rights reserved.</p>
    <div class="mt-2 space-x-4">
        <a class="hover:text-primary" asp-controller="Home" asp-action="Index">Help Center</a>
        <a class="hover:text-primary" asp-controller="Home" asp-action="Index">Artist Guidelines</a>
        <a class="hover:text-primary" asp-controller="Home" asp-action="Index">Contact</a>
    </div>
</footer>

</div>
</div>

<script>
    // Toggle artisan fields visibility
    document.querySelectorAll('input[name="role"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            var artisanFields = document.getElementById('artisan-fields');
            if (this.value === 'Artisan' && this.checked) {
                artisanFields.style.display = 'block';
            } else {
                artisanFields.style.display = 'none';
            }
        });
    });
</script>
