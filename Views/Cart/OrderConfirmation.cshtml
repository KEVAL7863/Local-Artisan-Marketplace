@model Local_Artisan_Marketplace.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<main class="max-w-3xl mx-auto px-4 py-16 text-center">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-primary/10 shadow-lg p-10">
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-symbols-outlined text-4xl text-green-600">check_circle</span>
        </div>

        <h1 class="text-3xl font-black tracking-tight mb-2">Order Confirmed!</h1>
        <p class="text-slate-500 mb-8">Thank you for supporting local artisans. Your order has been placed successfully.</p>

        <div class="bg-primary/5 rounded-xl p-6 mb-8 text-left">
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                    <p class="text-slate-500 font-medium">Order Number</p>
                    <p class="font-bold text-primary text-lg">#@Model.OrderNumber</p>
                </div>
                <div>
                    <p class="text-slate-500 font-medium">Order Date</p>
                    <p class="font-bold">@Model.OrderDate.ToString("MMM dd, yyyy")</p>
                </div>
                <div>
                    <p class="text-slate-500 font-medium">Status</p>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-700">@Model.Status</span>
                </div>
                <div>
                    <p class="text-slate-500 font-medium">Payment Method</p>
                    <p class="font-bold">@(Model.PaymentMethod ?? "Credit Card")</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-6 mb-8 text-left">
                <h3 class="font-bold mb-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">local_shipping</span>
                    Shipping To
                </h3>
                <p class="text-sm text-slate-600">@Model.FirstName @Model.LastName</p>
                <p class="text-sm text-slate-600">@Model.Address</p>
                <p class="text-sm text-slate-600">@Model.City, @Model.State @Model.ZipCode</p>
            </div>
        }

        <!-- Order Items -->
        <div class="text-left mb-8">
            <h3 class="font-bold mb-4">Order Items</h3>
            <div class="divide-y divide-primary/10">
                @foreach (var item in Model.OrderItems)
                {
                    <div class="flex justify-between items-center py-3">
                        <div>
                            <p class="font-medium">@item.Product.Title</p>
                            <p class="text-xs text-slate-500">Qty: @item.Quantity</p>
                        </div>
                        <p class="font-bold">&#8377;@((item.UnitPrice * item.Quantity).ToString("N2"))</p>
                    </div>
                }
            </div>
        </div>

        <!-- Totals -->
        <div class="border-t border-primary/10 pt-6 text-left">
            <div class="flex justify-between text-sm mb-2">
                <span class="text-slate-500">Subtotal</span>
                <span class="font-medium">&#8377;@Model.Subtotal.ToString("N2")</span>
            </div>
            <div class="flex justify-between text-sm mb-2">
                <span class="text-slate-500">Shipping</span>
                <span class="font-medium">@(Model.ShippingCost == 0 ? "Free" : "₹" + Model.ShippingCost.ToString("N2"))</span>
            </div>
            <div class="flex justify-between text-sm mb-4">
                <span class="text-slate-500">Tax (GST 18%)</span>
                <span class="font-medium">&#8377;@Model.Tax.ToString("N2")</span>
            </div>
            <div class="flex justify-between text-lg font-bold pt-4 border-t border-primary/10">
                <span>Total Paid</span>
                <span class="text-primary">&#8377;@Model.TotalAmount.ToString("N2")</span>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mt-10 justify-center">
            <a asp-controller="Product" asp-action="Index" class="px-8 py-3 bg-primary text-white rounded-xl font-bold hover:bg-primary/90 transition-all no-underline flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">shopping_bag</span>
                Continue Shopping
            </a>
            <a asp-controller="Home" asp-action="Index" class="px-8 py-3 border border-primary/20 text-primary rounded-xl font-bold hover:bg-primary/5 transition-all no-underline flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">home</span>
                Back to Home
            </a>
        </div>
    </div>
</main>
