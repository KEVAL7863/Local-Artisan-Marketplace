@model List<Local_Artisan_Marketplace.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal subtotal = 0;
    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            subtotal += item.Product.Price * item.Quantity;
        }
    }
    decimal shipping = subtotal >= 500 ? 0 : 50;
    decimal tax = Math.Round(subtotal * 0.18m, 2);
    decimal total = subtotal + shipping + tax;
}

<div class="layout-container flex flex-col min-h-screen">
<!-- Top Navigation Bar -->
<header class="border-b border-primary/10 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-3">
                    <div class="bg-primary text-white p-2 rounded-lg">
                        <span class="material-symbols-outlined block">storefront</span>
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="text-xl font-bold tracking-tight text-primary no-underline hover:text-primary/80">Artisan Marketplace</a>
                </div>
                <nav class="hidden md:flex items-center gap-8">
                    <a class="text-sm font-medium hover:text-primary transition-colors" asp-controller="Product" asp-action="Index">Shop</a>
                </nav>
            </div>
            <div class="flex items-center gap-4 lg:gap-6 flex-1 justify-end">
                <div class="flex items-center gap-2">
                    <a asp-controller="Cart" asp-action="Index" class="p-2 rounded-lg hover:bg-primary/10 transition-colors relative no-underline">
                        <span class="material-symbols-outlined">shopping_bag</span>
                        @if (Model != null && Model.Count > 0)
                        {
                            <span class="absolute top-1.5 right-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-white leading-none">@Model.Count</span>
                        }
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="p-2 rounded-lg hover:bg-primary/10 transition-colors">
                                <span class="material-symbols-outlined">logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="p-2 rounded-lg hover:bg-primary/10 transition-colors no-underline">
                            <span class="material-symbols-outlined">person</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</header>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full grow">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 mb-8 text-sm text-slate-500 dark:text-slate-400">
        <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Home</a>
        <span class="material-symbols-outlined text-base">chevron_right</span>
        <span class="text-slate-900 dark:text-slate-100 font-medium">Shopping Cart</span>
    </nav>

    @if (Model == null || Model.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-20">
            <span class="material-symbols-outlined text-slate-300 mb-6" style="font-size:80px;">shopping_cart</span>
            <h2 class="text-3xl font-black tracking-tight mb-2">Your Cart is Empty</h2>
            <p class="text-slate-500 mb-8">Looks like you haven't added any artisan products yet.</p>
            <a asp-controller="Product" asp-action="Index" class="bg-primary text-white font-bold px-8 py-4 rounded-xl hover:bg-primary/90 transition-all shadow-lg no-underline flex items-center gap-2">
                <span class="material-symbols-outlined">shopping_bag</span>
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-12">
            <!-- Shopping Cart Items List -->
            <div class="flex-1 space-y-8">
                <div class="flex items-end justify-between border-b border-primary/10 pb-6">
                    <h2 class="text-4xl font-black tracking-tight">Your Cart</h2>
                    <span class="text-slate-500 mb-1">@Model.Count item@(Model.Count > 1 ? "s" : "") in your cart</span>
                </div>
                <div class="space-y-6">
                    @foreach (var item in Model)
                    {
                        <div class="flex flex-col sm:flex-row gap-6 p-6 rounded-xl bg-white dark:bg-slate-900 border border-primary/5 shadow-sm">
                            <div class="w-full sm:w-32 h-32 rounded-lg bg-slate-100 dark:bg-slate-800 shrink-0 overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Title" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-4xl">image</span>
                                    </div>
                                }
                            </div>
                            <div class="flex-1 flex flex-col sm:flex-row justify-between gap-4">
                                <div class="space-y-1">
                                    <h3 class="text-lg font-bold">@item.Product.Title</h3>
                                    <p class="text-sm text-primary font-medium flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">auto_awesome</span>
                                        @(item.Product.Artisan?.StudioName ?? item.Product.Artisan?.FullName ?? "Artisan")
                                    </p>
                                    @if (!string.IsNullOrEmpty(item.Product.Category))
                                    {
                                        <p class="text-slate-500 text-sm mt-2">@item.Product.Category</p>
                                    }
                                    <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="mt-4">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="text-primary/60 hover:text-primary text-sm font-medium flex items-center gap-1">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                                <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-4">
                                    <p class="text-xl font-bold">₹@item.Product.Price.ToString("N2")</p>
                                    <div class="flex items-center gap-1 bg-primary/5 p-1 rounded-lg">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                            <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-primary/10 transition-colors" @(item.Quantity <= 1 ? "disabled" : "")>
                                                <span class="material-symbols-outlined text-lg">remove</span>
                                            </button>
                                        </form>
                                        <span class="w-10 text-center font-medium">@item.Quantity</span>
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                            <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-primary/10 transition-colors">
                                                <span class="material-symbols-outlined text-lg">add</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <!-- Shipping Info -->
                @if (shipping > 0)
                {
                    <div class="flex items-center gap-4 p-4 rounded-lg bg-primary/5 border border-primary/10 mt-8">
                        <span class="material-symbols-outlined text-primary">local_shipping</span>
                        <p class="text-sm">You are <strong>₹@((500 - subtotal).ToString("N2"))</strong> away from <strong>free shipping</strong> on artisan goods!</p>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-4 p-4 rounded-lg bg-green-50 border border-green-200 mt-8">
                        <span class="material-symbols-outlined text-green-600">local_shipping</span>
                        <p class="text-sm text-green-700"><strong>You qualify for free shipping!</strong></p>
                    </div>
                }
            </div>
            <!-- Cart Summary Sidebar -->
            <aside class="w-full lg:w-96">
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-8 border border-primary/10 shadow-lg sticky top-28">
                    <h3 class="text-xl font-bold mb-6">Order Summary</h3>
                    <div class="space-y-4 border-b border-primary/10 pb-6 mb-6">
                        <div class="flex justify-between text-slate-600 dark:text-slate-400">
                            <span>Subtotal</span>
                            <span class="text-slate-900 dark:text-slate-100 font-medium">₹@subtotal.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-slate-600 dark:text-slate-400">
                            <span>Shipping</span>
                            @if (shipping == 0)
                            {
                                <span class="text-green-600 font-medium">Free</span>
                            }
                            else
                            {
                                <span class="text-slate-900 dark:text-slate-100 font-medium">₹@shipping.ToString("N2")</span>
                            }
                        </div>
                        <div class="flex justify-between text-slate-600 dark:text-slate-400">
                            <span>Tax (GST 18%)</span>
                            <span class="text-slate-900 dark:text-slate-100 font-medium">₹@tax.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-baseline mb-8">
                        <span class="text-lg font-bold">Total</span>
                        <span class="text-3xl font-black text-primary">₹@total.ToString("N2")</span>
                    </div>
                    <a asp-controller="Cart" asp-action="Checkout" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 px-6 rounded-xl transition-all shadow-md flex items-center justify-center gap-2 group no-underline">
                        Proceed to Checkout
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </a>
                    <div class="mt-8 space-y-4">
                        <div class="flex gap-3 text-sm text-slate-500">
                            <span class="material-symbols-outlined text-primary text-xl">shield</span>
                            <span>Secure payments with artisan-first platform</span>
                        </div>
                        <div class="flex gap-3 text-sm text-slate-500">
                            <span class="material-symbols-outlined text-primary text-xl">package_2</span>
                            <span>Hand-packed and shipped directly from artisans</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Product" asp-action="Index" class="w-full mt-6 py-3 px-4 flex items-center justify-center gap-2 text-primary font-medium hover:underline no-underline">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Continue Shopping
                </a>
            </aside>
        </div>
    }
</main>

<!-- Footer -->
<footer class="bg-primary/5 border-t border-primary/10 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="col-span-1 md:col-span-2 space-y-4">
                <div class="flex items-center gap-3">
                    <div class="bg-primary text-white p-1.5 rounded-md">
                        <span class="material-symbols-outlined block text-sm">storefront</span>
                    </div>
                    <h2 class="text-lg font-bold tracking-tight text-primary">Artisan Marketplace</h2>
                </div>
                <p class="max-w-xs text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                    Connecting conscious collectors with independent artisans from around the world. Every piece tells a unique story.
                </p>
            </div>
            <div>
                <h4 class="font-bold mb-4">Support</h4>
                <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                    <li><a class="hover:text-primary" href="#">Shipping Policy</a></li>
                    <li><a class="hover:text-primary" href="#">Returns & Exchanges</a></li>
                    <li><a class="hover:text-primary" href="#">Contact Us</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-4">About</h4>
                <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                    <li><a class="hover:text-primary" asp-controller="Home" asp-action="Index">About Us</a></li>
                    <li><a class="hover:text-primary" asp-controller="Product" asp-action="Index">Meet the Artisans</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-12 pt-8 border-t border-primary/10 text-center">
            <p class="text-xs text-slate-500">© @DateTime.Now.Year Local Artisan Marketplace. Hand-crafted with care.</p>
        </div>
    </div>
</footer>
</div>
