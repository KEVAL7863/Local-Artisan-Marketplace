        <div>
            <h2 class="text-slate-900 dark:text-slate-100 text-3xl font-bold tracking-tight">Featured Artisans</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Meet the hands behind your favorite pieces.</p>
        </div>
        <a class="text-primary font-bold flex items-center gap-1 hover:underline no-underline" asp-controller="Product" asp-action="Index">
            View All <span class="material-symbols-outlined">chevron_right</span>
        </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8">
        <!-- Artisan 1 -->
        <div class="flex flex-col items-center gap-3 group cursor-pointer">
