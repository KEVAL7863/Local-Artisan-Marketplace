@model List<Local_Artisan_Marketplace.Models.Product>
@{
    ViewData["Title"] = "My Products";
    var totalCount = Model?.Count ?? 0;
    var lowStockCount = Model?.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 5) ?? 0;
    var activeCount = Model?.Count(p => p.IsActive) ?? 0;
}

<div class="flex min-h-screen">
    <!-- Sidebar Navigation -->
    <aside class="w-72 border-r border-primary/10 bg-white dark:bg-background-dark flex flex-col fixed h-full">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white">
                <span class="material-symbols-outlined">storefront</span>
            </div>
            <div>
                <h1 class="text-sm font-bold uppercase tracking-wider text-primary">Artisan Market</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">Seller Dashboard</p>
            </div>
        </div>
        <nav class="flex-1 px-4 space-y-2 mt-4">
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Dashboard">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg bg-primary/10 text-primary font-medium" asp-controller="Artisan" asp-action="MyProducts">
                <span class="material-symbols-outlined">inventory_2</span>
                <span>My Products</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="AddProduct">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Add Product</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Orders">
                <span class="material-symbols-outlined">shopping_bag</span>
                <span>Orders</span>
            </a>
        </nav>
        <div class="p-6 border-t border-primary/10">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-semibold truncate">@User.FindFirst(ClaimTypes.Name)?.Value</p>
                    <p class="text-xs text-slate-500 truncate">Artisan</p>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-primary/20 text-slate-600 dark:text-slate-400 text-sm font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-colors">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-72 flex-1 p-8 lg:p-12">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
            <div>
                <h2 class="text-3xl font-black tracking-tight mb-2">My Products</h2>
                <p class="text-slate-500 dark:text-slate-400">Manage your handcrafted items, monitor inventory, and update pricing.</p>
            </div>
            <a class="flex items-center justify-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-bold hover:brightness-110 transition-all shadow-lg shadow-primary/20 shrink-0" asp-controller="Artisan" asp-action="AddProduct">
                <span class="material-symbols-outlined">add</span>
                <span>Add New Product</span>
            </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-primary/10 shadow-sm">
                <p class="text-slate-500 text-sm font-medium mb-1">Total Products</p>
                <p class="text-3xl font-black text-primary">@totalCount</p>
            </div>
            <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-primary/10 shadow-sm">
                <p class="text-slate-500 text-sm font-medium mb-1">Low Stock Alert</p>
                <p class="text-3xl font-black text-amber-600">@lowStockCount</p>
            </div>
            <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-primary/10 shadow-sm">
                <p class="text-slate-500 text-sm font-medium mb-1">Active Listings</p>
                <p class="text-3xl font-black text-emerald-600">@activeCount</p>
            </div>
        </div>

        <!-- Products Table -->
        @if (Model != null && Model.Any())
        {
            <div class="bg-white dark:bg-slate-800 rounded-xl border border-primary/10 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-primary/5 border-b border-primary/10">
                                <th class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Thumbnail</th>
                                <th class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Product Name</th>
                                <th class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Price</th>
                                <th class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Stock Status</th>
                                <th class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary/5">
                            @foreach (var product in Model)
                            {
                                <tr class="hover:bg-primary/5 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="w-14 h-14 rounded-lg bg-slate-100 bg-cover bg-center border border-primary/10"
                                             style="background-image: url('@(product.ImageUrl ?? "")')"></div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col">
                                            <span class="font-bold text-slate-900 dark:text-white">@product.Title</span>
                                            <span class="text-xs text-slate-500">@product.Category</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-semibold text-slate-700 dark:text-slate-300">
                                        ₹@product.Price.ToString("N2")
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (product.StockQuantity <= 5)
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
                                                Low Stock (@product.StockQuantity left)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
                                                In Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-2">
                                            <a asp-controller="Artisan" asp-action="EditProduct" asp-route-id="@product.Id"
                                               class="p-2 text-slate-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-all" title="Edit">
                                                <span class="material-symbols-outlined text-sm">edit</span>
                                            </a>
                                            <form asp-controller="Artisan" asp-action="DeleteProduct" method="post" class="inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <button type="submit" class="p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all" title="Delete">
                                                    <span class="material-symbols-outlined text-sm">delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="bg-white dark:bg-slate-800 rounded-xl border border-primary/10 shadow-sm p-16 text-center">
                <div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center text-primary mx-auto mb-6">
                    <span class="material-symbols-outlined text-4xl">inventory_2</span>
                </div>
                <h3 class="text-xl font-bold mb-2">No Products Yet</h3>
                <p class="text-slate-500 mb-6">Start showcasing your handcrafted items to the world.</p>
                <a asp-controller="Artisan" asp-action="AddProduct"
                   class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                    <span class="material-symbols-outlined text-sm">add</span>
                    Add Your First Product
                </a>
            </div>
        }
    </main>
</div>
