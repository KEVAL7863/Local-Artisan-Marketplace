@{
    ViewData["Title"] = "Add New Product";
}

<div class="flex min-h-screen">
    <!-- Sidebar Navigation -->
    <aside class="w-72 border-r border-primary/10 bg-white dark:bg-background-dark flex flex-col fixed h-full">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white">
                <span class="material-symbols-outlined">storefront</span>
            </div>
            <div>
                <h1 class="text-sm font-bold uppercase tracking-wider text-primary">Artisan Market</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">Seller Dashboard</p>
            </div>
        </div>
        <nav class="flex-1 px-4 space-y-2 mt-4">
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Dashboard">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="MyProducts">
                <span class="material-symbols-outlined">inventory_2</span>
                <span>My Products</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg bg-primary/10 text-primary font-medium" asp-controller="Artisan" asp-action="AddProduct">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Add Product</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Orders">
                <span class="material-symbols-outlined">shopping_bag</span>
                <span>Orders</span>
            </a>
        </nav>
        <div class="p-6 border-t border-primary/10">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-semibold truncate">@(User.FindFirst(ClaimTypes.Name)?.Value ?? "Artisan")</p>
                    <p class="text-xs text-slate-500 truncate">Artisan</p>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-primary/20 text-slate-600 dark:text-slate-400 text-sm font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-colors">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

<!-- Main Content -->
<main class="ml-72 flex-1 flex flex-col min-w-0 overflow-hidden">
    <!-- Header -->
    <header class="h-16 border-b border-primary/10 bg-white dark:bg-background-dark/80 flex items-center justify-between px-8 sticky top-0 z-40">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">add_circle</span>
            <h2 class="text-lg font-bold tracking-tight">Add New Product</h2>
        </div>
        <div class="flex items-center gap-4">
            <button type="button" class="size-10 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary/10 hover:text-primary transition-all">
                <span class="material-symbols-outlined text-[20px]">notifications</span>
            </button>
            <button type="button" id="publishBtn" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors">
                Publish Product
            </button>
        </div>
    </header>

    <!-- Scrollable Form Area -->
    <div class="flex-1 overflow-y-auto p-8 max-w-5xl mx-auto w-full">
        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <div class="flex items-center gap-2 text-red-700 mb-2">
                    <span class="material-symbols-outlined text-sm">error</span>
                    <span class="text-sm font-semibold">Please fix the following errors:</span>
                </div>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm text-red-600 ml-6">@error.ErrorMessage</p>
                }
            </div>
        }

        <div class="mb-8">
            <h1 class="text-3xl font-bold mb-2">Create New Listing</h1>
            <p class="text-slate-500">Fill in the details to showcase your craft to the world.</p>
        </div>

        <form asp-controller="Artisan" asp-action="AddProduct" method="post" id="addProductForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                <!-- Left Column: Image Upload -->
                <div class="lg:col-span-1 space-y-6">
                    <section>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-primary mb-4">Product Media</h3>
                        <!-- Image Preview / Upload Area -->
                        <div id="imagePreviewArea" class="aspect-square rounded-xl border-2 border-dashed border-primary/20 bg-primary/5 flex flex-col items-center justify-center p-6 text-center group cursor-pointer hover:border-primary/50 transition-all overflow-hidden relative">
                            <input type="file" id="imageFile" name="imageFile" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
                            <div id="uploadPlaceholder">
                                <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform mx-auto">
                                    <span class="material-symbols-outlined text-3xl">cloud_upload</span>
                                </div>
                                <p class="text-sm font-semibold">Upload Image</p>
                                <p class="text-xs text-slate-500 mt-1">Click or drag and drop</p>
                            </div>
                            <img id="imagePreview" class="w-full h-full object-cover rounded-lg hidden absolute inset-0" alt="Product preview" />
                        </div>
                        <!-- Image URL Input -->
                        <div class="mt-4">
                            <label class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Or use Image URL</label>
                            <input type="url" id="imageUrl" name="imageUrl"
                                   class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-10 px-4 text-sm transition-all"
                                   placeholder="Paste image URL here" />
                        </div>
                        <!-- Additional image slots (visual) -->
                        <div class="grid grid-cols-3 gap-2 mt-4">
                            <div class="aspect-square rounded-lg bg-slate-100 dark:bg-slate-800 border border-primary/10 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined">add</span>
                            </div>
                            <div class="aspect-square rounded-lg bg-slate-100 dark:bg-slate-800 border border-primary/10 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined">add</span>
                            </div>
                            <div class="aspect-square rounded-lg bg-slate-100 dark:bg-slate-800 border border-primary/10 flex items-center justify-center text-slate-400">
                                <span class="material-symbols-outlined">add</span>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- Right Column: Form Details -->
                <div class="lg:col-span-2">
                    <div class="space-y-6">
                        <section class="space-y-4">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-primary mb-2">Basic Information</h3>
                            <!-- Product Title -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Product Title</label>
                                <input type="text" name="title" required
                                       class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base transition-all"
                                       placeholder="e.g. Hand-carved Teak Wood Bowl" />
                            </div>
                            <!-- Category + Stock -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Category</label>
                                    <select name="category"
                                            class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base appearance-none transition-all">
                                        <option value="Woodwork">Woodwork</option>
                                        <option value="Ceramics">Pottery</option>
                                        <option value="Textiles">Textiles</option>
                                        <option value="Jewelry">Jewelry</option>
                                        <option value="Paintings">Paintings</option>
                                        <option value="Leather">Leather</option>
                                        <option value="Home Decor">Home Decor</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Stock Availability</label>
                                    <input type="number" name="stockQuantity" min="0" value="1"
                                           class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base transition-all"
                                           placeholder="0" />
                                </div>
                            </div>
                            <!-- Price -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Price (₹)</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium">₹</span>
                                    <input type="number" name="price" min="1" step="0.01" required
                                           class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 pl-8 pr-4 text-base transition-all"
                                           placeholder="0.00" />
                                </div>
                            </div>
                            <!-- Description -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Description</label>
                                <textarea name="description" rows="5"
                                          class="w-full rounded-lg border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary p-4 text-base transition-all resize-none"
                                          placeholder="Tell the story of your craft, materials used, and care instructions..."></textarea>
                            </div>
                        </section>
                        <!-- Action Buttons -->
                        <section class="pt-6 border-t border-primary/10 flex items-center justify-end gap-4">
                            <a asp-controller="Artisan" asp-action="MyProducts"
                               class="px-6 py-2.5 rounded-lg border border-primary/20 text-slate-600 dark:text-slate-400 font-semibold hover:bg-slate-50 dark:hover:bg-slate-800 transition-all no-underline">
                                Cancel
                            </a>
                            <button type="submit"
                                    class="px-8 py-2.5 rounded-lg bg-primary text-white font-semibold shadow-lg shadow-primary/20 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all">
                                List Product
                            </button>
                        </section>
                    </div>
                </div>
            </div>
        </form>
    </div>
</main>
</div>

<script>
const imageFile = document.getElementById('imageFile');
const imageUrl = document.getElementById('imageUrl');
const preview = document.getElementById('imagePreview');
const placeholder = document.getElementById('uploadPlaceholder');

function updatePreview() {
    if (imageFile.files && imageFile.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.src = e.target.result;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
        }
        reader.readAsDataURL(imageFile.files[0]);
    } else if (imageUrl.value.trim() !== "") {
        preview.src = imageUrl.value.trim();
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
        preview.onerror = function() {
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
        };
    } else {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
    }
}

// Image File change
imageFile.addEventListener('change', updatePreview);

// Image URL change
imageUrl.addEventListener('input', updatePreview);

// Publish Product header button triggers form submit
document.getElementById('publishBtn').addEventListener('click', function() {
    document.getElementById('addProductForm').requestSubmit();
});
</script>
