@model Local_Artisan_Marketplace.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="flex min-h-screen">
    <!-- Sidebar Navigation -->
    <aside class="w-72 border-r border-primary/10 bg-white dark:bg-background-dark flex flex-col fixed h-full">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white">
                <span class="material-symbols-outlined">storefront</span>
            </div>
            <div>
                <h1 class="text-sm font-bold uppercase tracking-wider text-primary">Artisan Market</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">Seller Dashboard</p>
            </div>
        </div>
        <nav class="flex-1 px-4 space-y-2 mt-4">
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Dashboard">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg bg-primary/10 text-primary font-medium" asp-controller="Artisan" asp-action="MyProducts">
                <span class="material-symbols-outlined">inventory_2</span>
                <span>My Products</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="AddProduct">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Add Product</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-primary/5 transition-colors" asp-controller="Artisan" asp-action="Orders">
                <span class="material-symbols-outlined">shopping_bag</span>
                <span>Orders</span>
            </a>
        </nav>
        <div class="p-6 border-t border-primary/10">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="overflow-hidden">
                    <p class="text-sm font-semibold truncate">@User.FindFirst(ClaimTypes.Name)?.Value</p>
                    <p class="text-xs text-slate-500 truncate">Artisan</p>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-primary/20 text-slate-600 dark:text-slate-400 text-sm font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-colors">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-72 flex-1 p-8 lg:p-12">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-8">
                <h2 class="text-3xl font-black tracking-tight mb-2">Edit Product</h2>
                <p class="text-slate-500 dark:text-slate-400">Update the details for <span class="font-semibold text-slate-700 dark:text-slate-200">@Model.Title</span>.</p>
            </div>

            <!-- Form -->
            <form asp-controller="Artisan" asp-action="EditProduct" method="post" enctype="multipart/form-data"
                  class="bg-white dark:bg-slate-800 rounded-xl border border-primary/10 shadow-sm p-8 space-y-6">

                <input type="hidden" name="id" value="@Model.Id" />

                <!-- Product Image -->
                <div class="flex flex-col gap-3">
                    <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Product Image</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                        <div id="imagePreviewArea" class="aspect-video rounded-xl border-2 border-dashed border-primary/20 bg-primary/5 flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary/50 transition-all overflow-hidden relative">
                            <input type="file" id="imageFile" name="imageFile" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img id="imagePreview" src="@Model.ImageUrl" class="w-full h-full object-cover rounded-lg absolute inset-0" alt="Product preview" />
                                <div id="uploadPlaceholder" class="hidden">
                                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2 group-hover:scale-110 transition-transform mx-auto">
                                        <span class="material-symbols-outlined text-2xl">cloud_upload</span>
                                    </div>
                                    <p class="text-xs font-semibold">Change Image</p>
                                </div>
                            }
                            else
                            {
                                <img id="imagePreview" class="w-full h-full object-cover rounded-lg hidden absolute inset-0" alt="Product preview" />
                                <div id="uploadPlaceholder">
                                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2 group-hover:scale-110 transition-transform mx-auto">
                                        <span class="material-symbols-outlined text-2xl">cloud_upload</span>
                                    </div>
                                    <p class="text-xs font-semibold">Upload Image</p>
                                </div>
                            }
                        </div>
                        <div class="space-y-2">
                            <div class="flex flex-col gap-1.5 mb-4">
                                <label for="imageUrl" class="text-xs font-bold uppercase tracking-wider text-slate-500">Or use Image URL</label>
                                <input type="url" id="imageUrl" name="imageUrl" value="@Model.ImageUrl"
                                       class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-10 px-4 text-sm transition-all"
                                       placeholder="Paste image URL here" />
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                <span class="font-bold text-primary">Pro tip:</span> Use a high-quality image with a neutral background to make your product stand out.
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                Accepted formats: PNG, JPG, JPEG, WEBP.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Title -->
                <div class="flex flex-col gap-1.5">
                    <label for="title" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Product Title</label>
                    <input type="text" id="title" name="title" required value="@Model.Title"
                           class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base transition-all"
                           placeholder="e.g. Hand-carved Teak Wood Bowl" />
                </div>

                <!-- Category -->
                <div class="flex flex-col gap-1.5">
                    <label for="category" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Category</label>
                    @{
                        var categories = new[] { "Ceramics", "Woodwork", "Jewelry", "Textiles", "Paintings", "Home Decor", "Other" };
                    }
                    <select id="category" name="category" required
                            class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base transition-all">
                        @foreach (var cat in categories)
                        {
                            if (Model.Category == cat)
                            {
                                <option value="@cat" selected>@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    </select>
                </div>

                <!-- Price and Stock -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-1.5">
                        <label for="price" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Price (₹)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium">₹</span>
                            <input type="number" id="price" name="price" min="0" step="0.01" required value="@Model.Price"
                                   class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 pl-8 pr-4 text-base transition-all"
                                   placeholder="0.00" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="stockQuantity" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Stock Quantity</label>
                        <input type="number" id="stockQuantity" name="stockQuantity" min="0" required value="@Model.StockQuantity"
                               class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary h-12 px-4 text-base transition-all"
                               placeholder="0" />
                    </div>
                </div>

                <!-- Description -->
                <div class="flex flex-col gap-1.5">
                    <label for="description" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Description</label>
                    <textarea id="description" name="description" rows="5"
                              class="w-full rounded-lg border border-primary/10 bg-white dark:bg-slate-900 focus:border-primary focus:ring-primary p-4 text-base transition-all resize-none"
                              placeholder="Tell the story of your craft, materials used, and care instructions...">@Model.Description</textarea>
                </div>

                <!-- Active Toggle -->
                <div class="flex items-center gap-3 p-4 bg-primary/5 rounded-lg">
                    <input type="checkbox" id="isActive" name="isActive" value="true" @(Model.IsActive ? "checked" : "")
                           class="w-5 h-5 rounded border-primary/20 text-primary focus:ring-primary" />
                    <label for="isActive" class="text-sm font-semibold text-slate-700 dark:text-slate-300">
                        Product is active and visible on marketplace
                    </label>
                </div>

                <!-- Submit -->
                <div class="pt-4 border-t border-primary/10 flex justify-end gap-4">
                    <a asp-controller="Artisan" asp-action="MyProducts"
                       class="px-6 py-3 rounded-lg border border-primary/20 text-slate-600 dark:text-slate-400 font-semibold hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-8 py-3 rounded-lg bg-primary text-white font-semibold shadow-lg shadow-primary/20 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">save</span>
                        Update Product
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

<script>
const imageFile = document.getElementById('imageFile');
const imageUrl = document.getElementById('imageUrl');
const preview = document.getElementById('imagePreview');
const placeholder = document.getElementById('uploadPlaceholder');
const originalImageUrl = "@Model.ImageUrl";

function updatePreview() {
    if (imageFile.files && imageFile.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.src = e.target.result;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
        }
        reader.readAsDataURL(imageFile.files[0]);
    } else if (imageUrl.value.trim() !== "") {
        preview.src = imageUrl.value.trim();
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
        preview.onerror = function() {
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
        };
    } else if (originalImageUrl) {
        preview.src = originalImageUrl;
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
    } else {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
    }
}

// Image File change
imageFile.addEventListener('change', updatePreview);

// Image URL change
imageUrl.addEventListener('input', updatePreview);
</script>
