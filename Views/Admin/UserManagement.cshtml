@model List<Local_Artisan_Marketplace.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var users = Model ?? new List<Local_Artisan_Marketplace.Models.ApplicationUser>();
    var currentRole = ViewBag.CurrentRole as string ?? "";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var artisanCount = (int)(ViewBag.ArtisanCount ?? 0);
    var collectorCount = (int)(ViewBag.CollectorCount ?? 0);
    var suspendedCount = (int)(ViewBag.SuspendedCount ?? 0);
    var orderCounts = ViewBag.OrderCounts as Dictionary<int, dynamic> ?? new Dictionary<int, dynamic>();
    var productCounts = ViewBag.ProductCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var currentUserName = User.FindFirst(ClaimTypes.Name)?.Value;
    var currentUserEmail = User.FindFirst(ClaimTypes.Email)?.Value;
}

<div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-primary/10 bg-white dark:bg-background-dark/50 overflow-y-auto">
        <div class="flex flex-col h-full p-4 gap-8">
            <!-- Brand -->
            <div class="flex items-center gap-3 px-2">
                <div class="bg-primary/20 rounded-full flex items-center justify-center p-2">
                    <span class="material-symbols-outlined text-primary text-3xl">storefront</span>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-primary text-sm font-bold leading-tight">Artisan Market</h1>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">Admin Central</p>
                </div>
            </div>
            <!-- Nav -->
            <nav class="flex flex-col gap-1">
                <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Main Menu</p>
                <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">dashboard</span>
                    Dashboard
                </a>
                <a href="/Admin/UserManagement" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-primary text-white shadow-sm">
                    <span class="material-symbols-outlined text-xl">group</span>
                    Users
                </a>
                <a href="/Admin/ArtisanApproval" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">brush</span>
                    Artisans
                </a>
                <a href="/Admin/Orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">shopping_cart</span>
                    Orders
                </a>
            </nav>
            <!-- Bottom -->
            <div class="mt-auto flex flex-col gap-4">
                <div class="border-t border-primary/10 pt-4">
                    <div class="flex items-center gap-3 px-2">
                        <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center">
                            <span class="text-primary text-sm font-bold">@(currentUserName?.Substring(0, 1) ?? "A")</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate">@(currentUserName ?? "Admin")</p>
                            <p class="text-xs text-slate-500 truncate">@(currentUserEmail ?? "")</p>
                        </div>
                    </div>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center gap-2 px-3 py-2 w-full rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Header -->
        <header class="flex items-center justify-between px-8 py-4 border-b border-primary/10 bg-white dark:bg-background-dark/50 sticky top-0 z-40">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">User Management</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">Manage all marketplace users and their roles</p>
            </div>
            <div class="flex items-center gap-4">
                <form method="get" action="/Admin/UserManagement" class="relative w-72">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
                    <input type="text" name="search" value="@currentSearch" placeholder="Search users..." class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-background-dark text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    @if (!string.IsNullOrEmpty(currentRole))
                    {
                        <input type="hidden" name="role" value="@currentRole" />
                    }
                </form>
                <button class="relative p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">notifications</span>
                </button>
            </div>
        </header>

        <!-- Content -->
        <main class="flex-1 overflow-y-auto p-8">
            <!-- Filter Buttons -->
            <div class="flex items-center gap-3 mb-6">
                <a href="/Admin/UserManagement"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(string.IsNullOrEmpty(currentRole) ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 dark:text-slate-300 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    All Users
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(string.IsNullOrEmpty(currentRole) ? "bg-white/20" : "bg-slate-100 dark:bg-slate-800")">@totalCount</span>
                </a>
                <a href="/Admin/UserManagement?role=Artisan"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentRole == "Artisan" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 dark:text-slate-300 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Artisans
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentRole == "Artisan" ? "bg-white/20" : "bg-slate-100 dark:bg-slate-800")">@artisanCount</span>
                </a>
                <a href="/Admin/UserManagement?role=Collector"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentRole == "Collector" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 dark:text-slate-300 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Customers
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentRole == "Collector" ? "bg-white/20" : "bg-slate-100 dark:bg-slate-800")">@collectorCount</span>
                </a>
                <a href="/Admin/UserManagement?role=Suspended"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentRole == "Suspended" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 dark:text-slate-300 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Suspended
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentRole == "Suspended" ? "bg-white/20" : "bg-slate-100 dark:bg-slate-800")">@suspendedCount</span>
                </a>
            </div>

            <!-- Users Table -->
            <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-primary/10 bg-slate-50 dark:bg-slate-800/50">
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">User</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Role</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Joined</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Orders / Sales</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                                <th class="text-right px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary/10">
                            @if (users.Any())
                            {
                                @foreach (var user in users)
                                {
                                    var initials = "";
                                    if (!string.IsNullOrEmpty(user.FullName))
                                    {
                                        var parts = user.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                        initials = parts.Length >= 2
                                            ? $"{parts[0][0]}{parts[^1][0]}"
                                            : user.FullName.Substring(0, Math.Min(2, user.FullName.Length));
                                    }
                                    var roleBadgeClass = user.Role == "Artisan"
                                        ? "bg-primary/10 text-primary"
                                        : user.Role == "Admin"
                                            ? "bg-purple-100 text-purple-700"
                                            : "bg-slate-100 text-slate-600";
                                    var isActive = user.IsApproved;
                                    var hasOrders = orderCounts.ContainsKey(user.Id);
                                    var orderCount = hasOrders ? (int)orderCounts[user.Id].Count : 0;
                                    var orderTotal = hasOrders ? (decimal)orderCounts[user.Id].Total : 0m;
                                    var productCount = productCounts.ContainsKey(user.Id) ? productCounts[user.Id] : 0;
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors" data-user-row="@user.Id">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                                                    {
                                                        <img src="@user.ProfileImageUrl" alt="@user.FullName" class="w-10 h-10 rounded-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-primary text-sm font-bold uppercase">@initials</span>
                                                    }
                                                </div>
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">@user.FullName</p>
                                                    <p class="text-xs text-slate-500">@user.Email</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-full @roleBadgeClass">@user.Role</span>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">@user.JoinedDate.ToString("MMM dd, yyyy")</td>
                                        <td class="px-6 py-4">
                                            @if (user.Role == "Artisan")
                                            {
                                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">@productCount product(s)</p>
                                                <p class="text-xs text-slate-500">₹@orderTotal.ToString("N0") sales</p>
                                            }
                                            else
                                            {
                                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">@orderCount order(s)</p>
                                                <p class="text-xs text-slate-500">₹@orderTotal.ToString("N0") spent</p>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (isActive)
                                            {
                                                <span data-status-badge class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span data-status-badge class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-red-100 text-red-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                                    Suspended
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-end gap-2">
                                                <form method="post" action="/Admin/ToggleUserStatus" class="inline js-toggle-status-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    @if (isActive)
                                                    {
                                                        <button data-toggle-button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition-colors" title="Suspend User">
                                                            <span class="material-symbols-outlined text-sm">block</span>
                                                            Suspend
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button data-toggle-button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-100 text-green-700 hover:bg-green-200 transition-colors" title="Activate User">
                                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                                            Activate
                                                        </button>
                                                    }
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center">
                                        <span class="material-symbols-outlined text-slate-300 text-4xl">group_off</span>
                                        <p class="text-sm text-slate-400 mt-2">No users found</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="px-6 py-4 border-t border-primary/10 flex items-center justify-between">
                    <p class="text-sm text-slate-500">Showing @users.Count of @totalCount user(s)</p>
                    <div class="flex items-center gap-1">
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-400 bg-slate-100 cursor-not-allowed" disabled>Previous</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-primary text-white">1</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">2</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">3</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">Next</button>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
    document.querySelectorAll('.js-toggle-status-form').forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            var userIdInput = form.querySelector('input[name="userId"]');
            var button = form.querySelector('[data-toggle-button]');
            var row = form.closest('tr');
            var badge = row ? row.querySelector('[data-status-badge]') : null;

            if (!tokenInput || !userIdInput || !button || !badge) return;

            var token = tokenInput.value;
            var userId = userIdInput.value;
            var previousText = button.textContent;
            button.disabled = true;
            button.classList.add('opacity-60', 'cursor-not-allowed');

            try {
                var body = new URLSearchParams();
                body.append('__RequestVerificationToken', token);
                body.append('userId', userId);

                var response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body
                });

                if (!response.ok) {
                    button.disabled = false;
                    button.classList.remove('opacity-60', 'cursor-not-allowed');
                    return;
                }

                var result = await response.json();
                if (!result.success) {
                    button.disabled = false;
                    button.classList.remove('opacity-60', 'cursor-not-allowed');
                    return;
                }

                if (result.isActive) {
                    badge.className = 'inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-green-100 text-green-700';
                    badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active';
                    button.className = 'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition-colors';
                    button.title = 'Suspend User';
                    button.innerHTML = '<span class="material-symbols-outlined text-sm">block</span>Suspend';
                } else {
                    badge.className = 'inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-red-100 text-red-700';
                    badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Suspended';
                    button.className = 'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-100 text-green-700 hover:bg-green-200 transition-colors';
                    button.title = 'Activate User';
                    button.innerHTML = '<span class="material-symbols-outlined text-sm">check_circle</span>Activate';
                }

                button.disabled = false;
                button.classList.remove('opacity-60', 'cursor-not-allowed');
            } catch {
                button.textContent = previousText;
                button.disabled = false;
                button.classList.remove('opacity-60', 'cursor-not-allowed');
            }
        });
    });
</script>
