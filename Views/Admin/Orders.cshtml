@model List<Local_Artisan_Marketplace.Models.Order>
@{
    ViewData["Title"] = "Order Management";
    var orders = Model ?? new List<Local_Artisan_Marketplace.Models.Order>();
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var shippedCount = (int)(ViewBag.ShippedCount ?? 0);
    var deliveredCount = (int)(ViewBag.DeliveredCount ?? 0);
    var currentUserName = User.FindFirst(ClaimTypes.Name)?.Value;
    var currentUserEmail = User.FindFirst(ClaimTypes.Email)?.Value;
}

<div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-primary/10 bg-white dark:bg-background-dark/50 overflow-y-auto">
        <div class="flex flex-col h-full p-4 gap-8">
            <!-- Brand -->
            <div class="flex items-center gap-3 px-2">
                <div class="bg-primary/20 rounded-full flex items-center justify-center p-2">
                    <span class="material-symbols-outlined text-primary text-3xl">storefront</span>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-primary text-sm font-bold leading-tight">Artisan Market</h1>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">Admin Central</p>
                </div>
            </div>
            <!-- Nav -->
            <nav class="flex flex-col gap-1">
                <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Main Menu</p>
                <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">dashboard</span>
                    Dashboard
                </a>
                <a href="/Admin/UserManagement" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">group</span>
                    Users
                </a>
                <a href="/Admin/ArtisanApproval" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">brush</span>
                    Artisans
                </a>
                <a href="/Admin/Orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-primary text-white shadow-sm">
                    <span class="material-symbols-outlined text-xl">shopping_cart</span>
                    Orders
                </a>
            </nav>
            <!-- Bottom -->
            <div class="mt-auto flex flex-col gap-4">
                <div class="border-t border-primary/10 pt-4">
                    <div class="flex items-center gap-3 px-2">
                        <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center">
                            <span class="text-primary text-sm font-bold">@(currentUserName?.Substring(0, 1) ?? "A")</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate">@(currentUserName ?? "Admin")</p>
                            <p class="text-xs text-slate-500 truncate">@(currentUserEmail ?? "")</p>
                        </div>
                    </div>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center gap-2 px-3 py-2 w-full rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Header -->
        <header class="flex items-center justify-between px-8 py-4 border-b border-primary/10 bg-white dark:bg-background-dark/50 sticky top-0 z-40">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Order Management</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">Track and manage all marketplace orders</p>
            </div>
            <div class="flex items-center gap-4">
                <button class="relative p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">notifications</span>
                    @if (pendingCount > 0)
                    {
                        <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">@pendingCount</span>
                    }
                </button>
            </div>
        </header>

        <!-- Content -->
        <main class="flex-1 overflow-y-auto p-8">
            <!-- Status Filter Tabs -->
            <div class="flex items-center gap-3 mb-6">
                <a href="/Admin/Orders"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(string.IsNullOrEmpty(currentStatus) ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    All Orders
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(string.IsNullOrEmpty(currentStatus) ? "bg-white/20" : "bg-slate-100")">@((int)(ViewBag.TotalOrderCount ?? 0))</span>
                </a>
                <a href="/Admin/Orders?status=Pending"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentStatus == "Pending" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Pending
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentStatus == "Pending" ? "bg-white/20" : "bg-amber-100 text-amber-700")">@pendingCount</span>
                </a>
                <a href="/Admin/Orders?status=Shipped"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentStatus == "Shipped" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Shipped
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentStatus == "Shipped" ? "bg-white/20" : "bg-blue-100 text-blue-700")">@shippedCount</span>
                </a>
                <a href="/Admin/Orders?status=Delivered"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors @(currentStatus == "Delivered" ? "bg-primary text-white shadow-sm" : "bg-white dark:bg-background-dark/50 text-slate-600 border border-primary/10 hover:bg-primary/10 hover:text-primary")">
                    Delivered
                    <span class="text-xs px-1.5 py-0.5 rounded-full @(currentStatus == "Delivered" ? "bg-white/20" : "bg-green-100 text-green-700")">@deliveredCount</span>
                </a>
            </div>

            <!-- Order Tracking Heading + Search -->
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Order Tracking</h3>
                <form method="get" action="/Admin/Orders" class="relative w-80">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
                    <input type="text" name="search" value="@currentSearch" placeholder="Search orders..." class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-background-dark text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    @if (!string.IsNullOrEmpty(currentStatus))
                    {
                        <input type="hidden" name="status" value="@currentStatus" />
                    }
                </form>
            </div>

            <!-- Orders Table -->
            <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 overflow-hidden mb-8">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-primary/10 bg-slate-50 dark:bg-slate-800/50">
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Order ID</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Customer</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Date</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Total Amount</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                                <th class="text-right px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary/10">
                            @if (orders.Any())
                            {
                                @foreach (var order in orders)
                                {
                                    var customerName = order.Customer?.FullName ?? $"{order.FirstName} {order.LastName}";
                                    var initials = "";
                                    if (!string.IsNullOrEmpty(customerName))
                                    {
                                        var parts = customerName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                        initials = parts.Length >= 2
                                            ? $"{parts[0][0]}{parts[^1][0]}"
                                            : customerName.Substring(0, Math.Min(2, customerName.Length));
                                    }
                                    var badgeClass = order.Status switch
                                    {
                                        "Delivered" => "bg-green-100 text-green-700",
                                        "Shipped" => "bg-blue-100 text-blue-700",
                                        "Paid" => "bg-amber-100 text-amber-700",
                                        "Pending" => "bg-amber-100 text-amber-700",
                                        "Processing" => "bg-purple-100 text-purple-700",
                                        _ => "bg-slate-100 text-slate-700"
                                    };
                                    var dotClass = order.Status switch
                                    {
                                        "Delivered" => "bg-green-500",
                                        "Shipped" => "bg-blue-500",
                                        "Paid" => "bg-amber-500",
                                        "Pending" => "bg-amber-500",
                                        "Processing" => "bg-purple-500",
                                        _ => "bg-slate-500"
                                    };
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                        <td class="px-6 py-4">
                                            <span class="text-sm font-semibold text-primary">#@order.OrderNumber</span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                                                    <span class="text-primary text-xs font-bold uppercase">@initials</span>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-medium text-slate-800 dark:text-slate-200">@customerName</p>
                                                    <p class="text-xs text-slate-500">@(order.Customer?.Email ?? "")</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td class="px-6 py-4 text-sm font-semibold text-slate-900 dark:text-white">₹@order.TotalAmount.ToString("N0")</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full @badgeClass">
                                                <span class="w-1.5 h-1.5 rounded-full @dotClass"></span>
                                                @order.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-end gap-2">
                                                <form method="post" action="/Admin/UpdateOrderStatus" class="inline-flex items-center gap-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    @{
                                                        var statuses = new[] { "Pending", "Processing", "Paid", "Shipped", "Delivered" };
                                                    }
                                                    <select name="status" class="text-xs border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1.5 bg-white dark:bg-background-dark focus:outline-none focus:ring-2 focus:ring-primary/30">
                                                        @foreach (var s in statuses)
                                                        {
                                                            if (s == order.Status)
                                                            {
                                                                <option value="@s" selected>@s</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@s">@s</option>
                                                            }
                                                        }
                                                    </select>
                                                    <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary/10 text-primary hover:bg-primary/20 transition-colors">
                                                        <span class="material-symbols-outlined text-sm">sync</span>
                                                        Update
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center">
                                        <span class="material-symbols-outlined text-slate-300 text-4xl">receipt_long</span>
                                        <p class="text-sm text-slate-400 mt-2">No orders found</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="px-6 py-4 border-t border-primary/10 flex items-center justify-between">
                    <p class="text-sm text-slate-500">Showing @orders.Count order(s)</p>
                    <div class="flex items-center gap-1">
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-400 bg-slate-100 cursor-not-allowed" disabled>Previous</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-primary text-white">1</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">2</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">3</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">Next</button>
                    </div>
                </div>
            </div>

            <!-- Stats Summary -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-amber-600 text-2xl">pending_actions</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@pendingCount</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Pending Fulfillment</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-blue-600 text-2xl">local_shipping</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@shippedCount</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">In Transit</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-green-600 text-2xl">check_circle</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@deliveredCount</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Completed Today</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
