@model List<Local_Artisan_Marketplace.Models.ArtisanApplication>
@{
    ViewData["Title"] = "Artisan Approval";
    var pendingArtisans = ViewBag.PendingArtisans as List<Local_Artisan_Marketplace.Models.ApplicationUser> ?? new List<Local_Artisan_Marketplace.Models.ApplicationUser>();
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var pendingApplications = Model?.Where(a => a.Status == "Pending").ToList() ?? new List<Local_Artisan_Marketplace.Models.ArtisanApplication>();
    var currentUserName = User.FindFirst(ClaimTypes.Name)?.Value;
    var currentUserEmail = User.FindFirst(ClaimTypes.Email)?.Value;
}

<div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 flex-shrink-0 border-r border-primary/10 bg-white dark:bg-background-dark/50 overflow-y-auto">
        <div class="flex flex-col h-full p-4 gap-8">
            <!-- Brand -->
            <div class="flex items-center gap-3 px-2">
                <div class="bg-primary/20 rounded-full flex items-center justify-center p-2">
                    <span class="material-symbols-outlined text-primary text-3xl">storefront</span>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-primary text-sm font-bold leading-tight">Artisan Market</h1>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">Admin Central</p>
                </div>
            </div>
            <!-- Nav -->
            <nav class="flex flex-col gap-1">
                <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Main Menu</p>
                <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">dashboard</span>
                    Dashboard
                </a>
                <a href="/Admin/UserManagement" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">group</span>
                    Users
                </a>
                <a href="/Admin/ArtisanApproval" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-primary text-white shadow-sm">
                    <span class="material-symbols-outlined text-xl">brush</span>
                    Artisans
                </a>
                <a href="/Admin/Orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-xl">shopping_cart</span>
                    Orders
                </a>
            </nav>
            <!-- Bottom -->
            <div class="mt-auto flex flex-col gap-4">
                <div class="border-t border-primary/10 pt-4">
                    <div class="flex items-center gap-3 px-2">
                        <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center">
                            <span class="text-primary text-sm font-bold">@(currentUserName?.Substring(0, 1) ?? "A")</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate">@(currentUserName ?? "Admin")</p>
                            <p class="text-xs text-slate-500 truncate">@(currentUserEmail ?? "")</p>
                        </div>
                    </div>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center gap-2 px-3 py-2 w-full rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <span class="material-symbols-outlined text-xl">logout</span>
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Header -->
        <header class="flex items-center justify-between px-8 py-4 border-b border-primary/10 bg-white dark:bg-background-dark/50 sticky top-0 z-40">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Artisan Approval</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">Review and manage artisan applications</p>
            </div>
            <div class="flex items-center gap-4">
                <button class="relative p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">notifications</span>
                    @if (pendingCount > 0)
                    {
                        <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">@pendingCount</span>
                    }
                </button>
            </div>
        </header>

        <!-- Content -->
        <main class="flex-1 overflow-y-auto p-8">
            <!-- Statistics Bar -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-amber-600 text-2xl">pending_actions</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@pendingCount</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Pending Applications</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-green-600 text-2xl">check_circle</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">@approvedCount</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Approved Today</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-blue-600 text-2xl">schedule</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">1.5 Days</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Avg Review Time</p>
                    </div>
                </div>
            </div>

            <!-- Pending Applications Table -->
            <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-primary/10 flex items-center justify-between">
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">Pending Applications</h3>
                    <span class="text-sm text-slate-500">@(pendingArtisans.Count + pendingApplications.Count) pending review(s)</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-primary/10 bg-slate-50 dark:bg-slate-800/50">
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Applicant</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Specialty</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Date</th>
                                <th class="text-left px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                                <th class="text-right px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary/10">
                            @* Pending Artisans from ViewBag *@
                            @foreach (var artisan in pendingArtisans)
                            {
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(artisan.ProfileImageUrl))
                                                {
                                                    <img src="@artisan.ProfileImageUrl" alt="@artisan.FullName" class="w-10 h-10 rounded-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-primary text-sm font-bold">@artisan.FullName.Substring(0, 1)</span>
                                                }
                                            </div>
                                            <div>
                                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">@artisan.FullName</p>
                                                <p class="text-xs text-slate-500">@(artisan.StudioName ?? "No studio")</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-block bg-primary/10 text-primary text-xs font-medium px-2.5 py-1 rounded-full">@(artisan.CraftType ?? "General")</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">@artisan.JoinedDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Pending
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end gap-2">
                                            <form asp-action="ApproveArtisan" asp-controller="Admin" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@artisan.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-100 text-green-700 hover:bg-green-200 transition-colors">
                                                    <span class="material-symbols-outlined text-sm">check</span>
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectArtisan" asp-controller="Admin" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@artisan.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition-colors">
                                                    <span class="material-symbols-outlined text-sm">close</span>
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @* Pending Applications from Model *@
                            @foreach (var app in pendingApplications)
                            {
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(app.ShopImageUrl))
                                                {
                                                    <img src="@app.ShopImageUrl" alt="@app.ShopName" class="w-10 h-10 rounded-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-primary text-sm font-bold">@app.ShopName.Substring(0, 1)</span>
                                                }
                                            </div>
                                            <div>
                                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">@app.ShopName</p>
                                                <p class="text-xs text-slate-500">@(app.Applicant?.FullName ?? "Unknown Applicant")</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-block bg-primary/10 text-primary text-xs font-medium px-2.5 py-1 rounded-full">@app.Specialty</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">@app.SubmissionDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Pending
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end gap-2">
                                            <form asp-action="ApproveArtisan" asp-controller="Admin" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@app.ApplicantId" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-100 text-green-700 hover:bg-green-200 transition-colors">
                                                    <span class="material-symbols-outlined text-sm">check</span>
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectArtisan" asp-controller="Admin" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@app.ApplicantId" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition-colors">
                                                    <span class="material-symbols-outlined text-sm">close</span>
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (!pendingArtisans.Any() && !pendingApplications.Any())
                            {
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center">
                                        <span class="material-symbols-outlined text-slate-300 text-4xl">inbox</span>
                                        <p class="text-sm text-slate-400 mt-2">No pending applications to review</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="px-6 py-4 border-t border-primary/10 flex items-center justify-between">
                    <p class="text-sm text-slate-500">Showing @(pendingArtisans.Count + pendingApplications.Count) result(s)</p>
                    <div class="flex items-center gap-1">
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-400 bg-slate-100 cursor-not-allowed" disabled>Previous</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium bg-primary text-white">1</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">2</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">3</button>
                        <button class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">Next</button>
                    </div>
                </div>
            </div>

            <!-- Review Guidelines -->
            <div class="bg-white dark:bg-background-dark/50 rounded-xl border border-primary/10 p-6">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Review Guidelines</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-blue-600">verified</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Verify Identity</p>
                            <p class="text-xs text-slate-500 mt-1">Confirm the applicant's identity and ensure all provided information is authentic and verifiable.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-primary">palette</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Check Craft Quality</p>
                            <p class="text-xs text-slate-500 mt-1">Review the quality and authenticity of the artisan's craft work and portfolio samples.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-green-600">gavel</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Policy Compliance</p>
                            <p class="text-xs text-slate-500 mt-1">Ensure the applicant agrees to and meets all marketplace policies and community guidelines.</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
